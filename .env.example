# Local SQLite database file (relative to prisma/ when using `file:`)
DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js — set NEXTAUTH_SECRET to a strong random value in real envs.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Optional admin credentials used by `prisma db seed` to create the first admin.
# Defaults: admin@blog.com / admin123
ADMIN_EMAIL="admin@blog.com"
ADMIN_PASSWORD="admin123"
