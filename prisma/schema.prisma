// Minimal Blog CMS - Prisma schema.
// T2 introduces the User model required for authentication. The remaining
// models (Post, Category, Tag, Comment, Media, PostTag) and the FTS5
// virtual table are added in T3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite does not support native enum types, so Role is stored as a string.
// Allowed values: "admin" | "reader". Validated at the application layer.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("reader")
  createdAt    DateTime @default(now())
}
